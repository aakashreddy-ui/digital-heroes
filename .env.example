# DIGITAL HEROES ROOT ENVIRONMENT VARIABLES

# Node / Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Database Configuration
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, connects to Supabase/PostgreSQL.
# Otherwise, defaults to zero-config high-performance SQLite database (data/digital_heroes.db).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=

# Stripe Test Mode Configuration
# When STRIPE_SECRET_KEY is provided, performs live Stripe Checkout & Webhook verification.
# When empty, operates in Stripe Simulator mode for seamless offline testing.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_SIMULATOR_ENABLED=true

STRIPE_MONTHLY_PRICE_ID=price_replace-me
STRIPE_YEARLY_PRICE_ID=price_replace-me

# Payouts remain manual until a regulated payout provider is integrated.
PAYOUT_PROVIDER=manual
PAYOUT_API_KEY=

# Client Application URL
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5001/api
VITE_API_BASE_URL=/api
